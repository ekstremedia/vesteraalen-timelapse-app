# Vesterålen Timelapse App Environment Configuration
# Copy this file to .env and update values as needed

# API Base URL (production)
API_BASE_URL=https://ekstremedia.no

# API Base URL for development (optional)
# API_BASE_URL=http://localhost:8000

# Cache durations in seconds
CACHE_CAMERAS_TTL=30
CACHE_TIMELAPSE_TODAY_TTL=30
CACHE_TIMELAPSE_HISTORICAL_TTL=300
CACHE_AVAILABLE_DATES_TTL=3600

# Polling interval in seconds
POLLING_INTERVAL=60

# WebSocket (Laravel Reverb) Configuration
# Set to true to enable real-time updates via WebSocket
WEBSOCKET_ENABLED=false

# Reverb server settings
# For production, use wss and your domain
REVERB_HOST=ekstremedia.no
REVERB_PORT=8080
REVERB_SCHEME=https
REVERB_APP_KEY=your-reverb-app-key
